{
  "name": "aidcp-edge",
  "version": "0.3.14",
  "private": true,
  "description": "AIDCP 边缘端：DOM-first 定位层引擎 + CDP（原生 WebSocket）页面接入（DomProvider / ActionExecutor）+ 边-云 WS 客户端（点赞垂直切片）。",
  "author": "AIDCP",
  "type": "module",
  "main": "src/electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:dist": "npm run clean:dist && tsc -p tsconfig.build.json",
    "build:ads-runtime": "node scripts/stage-ads-runtime.mjs",
    "electron:dev": "electron .",
    "electron:build": "npm run build:dist && npm run build:ads-runtime && node ./node_modules/electron-builder/cli.js",
    "electron:build:win": "npm run build:dist && npm run build:ads-runtime && node ./node_modules/electron-builder/cli.js --win",
    "electron:build:mac": "npm run build:dist && npm run build:ads-runtime && node ./node_modules/electron-builder/cli.js --mac",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:acceptance": "tsx --test test/acceptance/*.test.ts",
    "start": "tsx src/main.ts",
    "start:multinode": "tsx scripts/launch-multinode.ts",
    "dev:cloud": "bash scripts/dev-run.sh"
  },
  "build": {
    "appId": "com.aidcp.edge",
    "productName": "AIDCP",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "src/electron/**/*.cjs",
      "src/electron/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/ads-runtime/adspower-browser",
        "to": "adspower-browser"
      },
      {
        "from": "resources/ads-runtime.json",
        "to": "ads-runtime.json"
      }
    ],
    "extraMetadata": {
      "main": "src/electron/main.cjs"
    },
    "win": {
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "jsdom": "^25.0.1",
    "ws": "^8.21.0"
  }
}
